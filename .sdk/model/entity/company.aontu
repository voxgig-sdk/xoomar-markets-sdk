          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    shortRatio: {
      h: "Short Ratio"
      n: "shortRatio"
      r: false
      sh: "shortVolume divided by totalVolume"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    shortVolume: {
      h: "Short Volume"
      n: "shortVolume"
      r: false
      sh: "Shares sold short that day, as reported to FINRA's facilities"
      t: "`$NUMBER`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      sh: "Fund slug for URLs"
      t: "`$STRING`"
    }
    source: {
      h: "Source"
      n: "source"
      r: false
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "Issuer state or country code"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "reported (an 8-K with Item 2.02 on EDGAR) or estimated (an expected date, shown until the company's 8-K arrives)"
      t: "`$STRING`"
    }
    symbol: {
      h: "Symbol"
      n: "symbol"
      r: false
      sh: "Ticker"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    ticker: {
      h: "Ticker"
      n: "ticker"
      r: false
      sh: "Listed ticker"
      t: "`$STRING`"
    }
    totalAmountSold: {
      h: "Total Amount Sold"
      n: "totalAmountSold"
      r: false
      sh: "USD sold as of the filing"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    totalOfferingAmount: {
      h: "Total Offering Amount"
      n: "totalOfferingAmount"
      r: false
      sh: "USD; null when indefinite"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    totalVolume: {
      h: "Total Volume"
      n: "totalVolume"
      r: false
      sh: "Total shares reported to FINRA's facilities that day (not the consolidated tape)"
      t: "`$NUMBER`"
    }
    trades: {
      h: "Trades"
      n: "trades"
      r: false
      sh: "Open-market purchase transactions in the window"
      t: "`$NUMBER`"
    }
    txDate: {
      fo: "date"
      h: "Tx Date"
      n: "txDate"
      r: false
      sh: "Transaction date from the filing, YYYY-MM-DD"
      t: "`$STRING`"
    }
    underlyings: {
      h: "Underlyings"
      n: "underlyings"
      r: false
      sh: "Parsed underlying symbols (SPX, NDX, NVDA...)."
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    units: {
      h: "Units"
      n: "units"
      r: false
      sh: "Bitcoin held as tagged in the filing; null when the filing gives no usable count"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    unitsOutstanding: {
      h: "Units Outstanding"
      n: "unitsOutstanding"
      r: false
      sh: "Shares or units of the class outstanding"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    unitsReliable: {
      h: "Units Reliable"
      n: "unitsReliable"
      r: false
      sh: "true when the filing gives a usable coin count"
      t: "`$BOOLEAN`"
    }
    unitsToSell: {
      h: "Units To Sell"
      n: "unitsToSell"
      r: false
      sh: "Shares or units to be sold"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    updatedAt: {
      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: false
      sh: "When the response was built; a few dated feeds give the date of their newest row instead"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "Hub page"
      t: "`$STRING`"
    }
    valueUsd: {
      h: "Value Usd"
      n: "valueUsd"
      r: false
      sh: "quantity times price, USD"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
  }

