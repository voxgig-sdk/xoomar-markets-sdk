  name: "macro"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/markets/calendar"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2026-01-01"
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "importance"
                or: "importance"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2026-01-01"
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/calendar"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "calendar"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /api/markets/cot"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/markets/cot"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "cot"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /api/markets/fed-liquidity"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 5000
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "series"
                or: "series"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/fed-liquidity"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "fed-liquidity"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /api/markets/macro"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2026-01-01"
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "series"
                or: "series"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2026-01-01"
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/macro"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "macro"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /api/markets/rates"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/markets/rates"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "rates"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /api/markets/treasury-auctions"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2026-01-01"
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 100
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "10-Year"
                k: "query"
                n: "term"
                or: "term"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2026-01-01"
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "upcoming"
                or: "upcoming"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/treasury-auctions"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "treasury-auctions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/markets/rates/{country}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "us"
                k: "param"
                n: "country"
                or: "country"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "2026-01-01"
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2026-01-01"
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/rates/{country}"
          q: {
            exist: [
              "country"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "rates"
            }
            {
              var: "country"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /api/markets/cot/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "e-mini-s-p-500-stock-index"
                k: "param"
                n: "slug"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "2026-01-01"
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2026-01-01"
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/markets/cot/{slug}"
          q: {
            exist: [
              "slug"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "markets"
            }
            {
              lit: "cot"
            }
            {
              var: "slug"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
